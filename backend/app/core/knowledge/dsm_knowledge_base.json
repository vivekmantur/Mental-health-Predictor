      "icd10": "ICD-10-CM billing code — use for clinical records, EHR export, or insurance integration",
      "icd9": "ICD-9-CM legacy code — kept for backward compatibility with older systems",
      "keywords": "Natural language terms a patient or clinician might type in a free-text notes field. Used for fuzzy/semantic text matching.",
      "specifiers": "Subtypes or severity levels under this disorder (optional)"
    }
